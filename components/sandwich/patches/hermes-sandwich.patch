+def _bun_manifest_paths() -> tuple[Path, ...]:
+    """Bun lockfile and manifests installed by ``hermes update``.
+
+    Desktop, JavaScript tests, and other optional workspaces are intentionally
+    absent: the update path never installs them. Their own launch/test commands
+    remain responsible for their dependency state.
+    """
+    paths = [
+        PROJECT_ROOT / "bun.lock",
+        PROJECT_ROOT / "package.json",
+        PROJECT_ROOT / "web" / "package.json",
+        PROJECT_ROOT / "ui-tui" / "package.json",
+    ]
+    for match in sorted((PROJECT_ROOT / "ui-tui" / "packages").glob("*")):
+        manifest = match / "package.json"
+        if manifest.is_file():
+            paths.append(manifest)
+    return tuple(paths)
+
+
+def _bun_manifests_digest() -> str | None:
+    """Combined sha256 over ``bun.lock`` and every workspace manifest."""
+    if not (PROJECT_ROOT / "bun.lock").is_file():
+        return None
+    h = hashlib.sha256()
+    for path in _bun_manifest_paths():
+        h.update(str(path.relative_to(PROJECT_ROOT)).encode())
+        try:
+            h.update(path.read_bytes())
+        except OSError:
+            h.update(b"<missing>")
+    return h.hexdigest()
+
+
+def _bun_lockfile_changed(hermes_root: Path) -> bool:
+    current = _bun_manifests_digest()
+    if current is None or not (PROJECT_ROOT / "node_modules").is_dir():
+        return True
+    try:
+        cache_key = hashlib.sha256(str(PROJECT_ROOT).encode()).hexdigest()[:12]
+        cache_file = hermes_root / f".bun_lock_hash_{cache_key}"
+        return (
+            not cache_file.is_file()
+            or cache_file.read_text(encoding="utf-8").strip() != current
+        )
+    except OSError:
+        return True
+
+
+def _record_bun_lockfile_hash(hermes_root: Path) -> None:
+    digest = _bun_manifests_digest()
+    if digest is None:
+        return
+    try:
+        cache_key = hashlib.sha256(str(PROJECT_ROOT).encode()).hexdigest()[:12]
+        cache_file = hermes_root / f".bun_lock_hash_{cache_key}"
+        cache_file.write_text(digest, encoding="utf-8")
+    except OSError:
+        logger.debug("Could not write Bun lockfile hash cache")
+
