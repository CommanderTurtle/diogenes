+        import hermes_constants
+
+        (tmp_path / "package.json").write_text("{}")
+        (tmp_path / "bun.lock").write_text("lockfileVersion = 1\n")
+        for workspace in ("web", "ui-tui", "apps/desktop"):
+            path = tmp_path / workspace
+            path.mkdir(parents=True)
+            (path / "package.json").write_text("{}")
+
+        shared_root = tmp_path / ".hermes"
+        shared_root.mkdir()
+        observed = []
+
+        monkeypatch.setattr(hm, "PROJECT_ROOT", tmp_path)
+        monkeypatch.setattr(
+            hm, "_resolve_bun_runtime", lambda: "/home/user/.bun/bin/bun"
+        )
+        monkeypatch.setattr(hm, "_bun_lockfile_changed", lambda root: True)
+        monkeypatch.setattr(
+            hm,
+            "_run_bun_install_deterministic",
+            lambda *args, **kwargs: (
+                observed.append((args, kwargs))
+                or subprocess.CompletedProcess([], 0, stdout="", stderr="")
+            ),
+        )
+        monkeypatch.setattr(hm, "_record_bun_lockfile_hash", lambda root: None)
+        monkeypatch.setattr(
+            hermes_constants, "get_default_hermes_root", lambda: shared_root
+        )
+
+        assert hm._update_node_dependencies() == []
+        assert len(observed) == 1
+        _, kwargs = observed[0]
+        assert kwargs["filters"] == (
+            "--filter",
+            "./",
+            "--filter",
+            "./ui-tui",
+            "--filter",
+            "./web",
+        )
+        assert "desktop" not in " ".join(kwargs["filters"])
+
+    def test_cache_ignores_desktop_manifest_changes(self, tmp_path, monkeypatch):
+        from hermes_cli import main as hm
+
+        monkeypatch.setattr(hm, "PROJECT_ROOT", tmp_path)
+        (tmp_path / "bun.lock").write_text("lockfileVersion = 1\n")
+        (tmp_path / "package.json").write_text("{}")
