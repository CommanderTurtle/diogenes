{
  "schema_version": "ulysses.colibri-providers.v1",
  "providers": [
    {
      "id": "colibri.glm",
      "label": "Colibri · GLM-5.2",
      "family": "glm",
      "source_url": "https://github.com/JustVugg/colibri.git",
      "source_branch": "dev",
      "source_env": "ULYSSES_COLIBRI_GLM_ROOT",
      "source_default": "Odysseus/colibri",
      "model_env": "ULYSSES_COLIBRI_GLM_MODEL",
      "model_default": "colibri-models/mastouri--GLM-5.2-colibri-int4-g64-with-int8-mtp",
      "port_env": "ULYSSES_COLIBRI_GLM_PORT",
      "default_port": 8642,
      "model_id": "glm-5.2-colibri",
      "weight_repo": "mastouri/GLM-5.2-colibri-int4-g64-with-int8-mtp",
      "model_variants": [
        {
          "id": "gs64-int8-mtp",
          "label": "GLM-5.2 gs64 + int8 MTP",
          "repository": "mastouri/GLM-5.2-colibri-int4-g64-with-int8-mtp",
          "revision": "5276684ba30ac0026c07220d3f389171a84eb074",
          "directory": "mastouri--GLM-5.2-colibri-int4-g64-with-int8-mtp",
          "recommended": true,
          "model_type": "glm_moe_dsa",
          "main_shards": 141,
          "mtp_shards": 1,
          "weight_bytes": 429255863080,
          "required_files": [
            "config.json",
            "generation_config.json",
            "tokenizer.json",
            "tokenizer_config.json"
          ],
          "quality_note": "Current upstream-recommended group-size-64 container; preserves substantially more quality than legacy per-row int4."
        }
      ],
      "minimum_commit": "5f167e5964f40a3a62d4cadb911543ce0f15b49b",
      "minimum_commit_reason": "Merged PR #274: single-GPU decode pipeline and expert-cache reserve fix",
      "cli_path": "c/coli",
      "engine_path": "c/colibri",
      "setup_path": "c/setup.sh",
      "build_cwd": "c",
      "build_argv": ["make", "colibri", "CUDA=1", "CUDA_ARCH=native"],
      "validation_steps": [
        {
          "label": "Run upstream Colibri tests",
          "argv": ["make", "test"],
          "timeout": 1800
        },
        {
          "label": "Validate Colibri CUDA kernels",
          "argv": ["make", "cuda-test", "CUDA=1", "CUDA_ARCH=native"],
          "timeout": 900
        }
      ],
      "plan_args": ["plan", "--auto-tier", "--gpu", "0", "--json"],
      "doctor_args": ["doctor", "--auto-tier", "--gpu", "0", "--json"],
      "serve_args": [
        "serve",
        "--auto-tier",
        "--gpu",
        "0",
        "--host",
        "127.0.0.1",
        "--max-queue",
        "8",
        "--queue-timeout",
        "300",
        "--kv-slots",
        "1"
      ],
      "supports_tools": true,
      "model_type": "llm",
      "default_profile": "rtx5090-high-ram",
      "profiles": {
        "rtx5090-high-ram": {
          "label": "RTX 5090 · high RAM",
          "description": "Correctness-first single-GPU profile derived from issue #273 and current dev settings. Experimental expert caps, cache routing, and CUDA MTP remain off.",
          "ram": "56",
          "auto_tier": true,
          "ctx": "4096",
          "gpu": "0",
          "vram": "0",
          "policy": "balanced",
          "env": {
            "COLI_CUDA": "1",
            "CUDA_DENSE": "1",
            "COLI_CUDA_ATTN": "1",
            "COLI_CUDA_PIPE": "2",
            "DIRECT": "1",
            "PIPE": "1",
            "PIPE_WORKERS": "8",
            "PILOT_REAL": "1",
            "EXPERT_BUDGET": "0",
            "CACHE_ROUTE": "0"
          }
        },
        "upstream-auto": {
          "label": "Upstream auto-tier",
          "description": "Minimal current-dev auto-tier profile with no Diogenes tuning overrides.",
          "ram": "0",
          "auto_tier": true,
          "ctx": "4096",
          "gpu": "0",
          "vram": "0",
          "policy": "balanced",
          "env": {}
        }
      },
      "documentation": {
        "repository": "https://github.com/JustVugg/colibri",
        "api": "https://github.com/JustVugg/colibri/blob/dev/docs/api.md",
        "cuda": "https://github.com/JustVugg/colibri/blob/dev/docs/cuda.md",
        "optimization": "https://github.com/JustVugg/colibri/issues/273"
      }
    },
    {
      "id": "colibri.hy3",
      "label": "Colibri · Hy3",
      "family": "hy3",
      "source_url": "https://github.com/ErikTromp/colibri-hy3.git",
      "source_branch": "main",
      "source_env": "ULYSSES_COLIBRI_HY3_ROOT",
      "source_default": "Odysseus/colibri-hy3",
      "model_env": "ULYSSES_COLIBRI_HY3_MODEL",
      "model_default": "colibri-models/UnderstandLing--Hy3-colibri-int4",
      "port_env": "ULYSSES_COLIBRI_HY3_PORT",
      "default_port": 8643,
      "model_id": "hy3-colibri",
      "weight_repo": "UnderstandLing/Hy3-colibri-int4",
      "model_variants": [
        {
          "id": "int4-int8-mtp",
          "label": "Hy3 int4 + int8 MTP",
          "repository": "UnderstandLing/Hy3-colibri-int4",
          "revision": "2aed3aedf043f81d8c03c0e98c27d1e61b29981d",
          "directory": "UnderstandLing--Hy3-colibri-int4",
          "recommended": true,
          "model_type": "hy_v3",
          "main_shards": 101,
          "mtp_shards": 6,
          "weight_bytes": 152446149696,
          "required_files": [
            "config.json",
            "generation_config.json",
            "tokenizer.json",
            "tokenizer_config.json"
          ],
          "quality_note": "The sole pre-converted container supported by the official Colibri-Hy3 fork."
        }
      ],
      "minimum_commit": "08f8439ebfe1994b607aed6adf857c80e8894c4c",
      "minimum_commit_reason": "Official main revision inspected for the native Hy3 provider contract",
      "cli_path": "c/coli",
      "engine_path": "c/hy3",
      "setup_path": "c/setup.sh",
      "build_cwd": "c",
      "build_argv": ["make", "hy3", "CUDA=1", "IOURING=1"],
      "build_compatibility": {
        "id": "hy3-cuda-matmul-group-size",
        "source_commit": "08f8439ebfe1994b607aed6adf857c80e8894c4c",
        "path": "c/hy3.c",
        "before": "coli_cuda_matmul(&w->cuda,y,x,weights,w->s,w->fmt,S,w->I,w->O,w->cuda_device))",
        "after": "coli_cuda_matmul(&w->cuda,y,x,weights,w->s,w->fmt,S,w->I,w->O,w->cuda_device,0))",
        "reason": "The official Hy3 merge adopted the grouped CUDA backend signature but left the non-grouped Hy3 call site one argument behind."
      },
      "validation_steps": [
        {
          "label": "Run upstream Colibri-Hy3 tests",
          "argv": ["make", "test"],
          "timeout": 1800
        },
        {
          "label": "Validate Colibri-Hy3 CUDA kernels",
          "argv": ["make", "cuda-test", "CUDA=1", "CUDA_ARCH=native"],
          "timeout": 900
        },
        {
          "label": "Validate the Hy3 teacher-forcing oracle",
          "argv": ["env", "SNAP=./hy3_tiny", "TF=1", "./hy3", "64", "16", "16"],
          "timeout": 300,
          "expected_output_contains": "32/32 positions"
        }
      ],
      "plan_args": [
        "plan",
        "--ram",
        "0",
        "--auto-tier",
        "--gpu",
        "0",
        "--vram",
        "0",
        "--policy",
        "balanced",
