      "category": "native",
      "dependency_section": "Interactive services",
      "recommended": true,
      "capability_group": "messaging",
      "role": "Interactive Signal backend",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/signal-cli",
      "env_files": [".env"],
      "config_files": [
        {"path": "start.sh", "format": "shell"},
        {"path": "runconfig.sh", "format": "shell"}
      ],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Used when no legacy runconfig.sh exists.\nSIGNAL_ACCOUNT=\nSIGNAL_HTTP_HOST=127.0.0.1\nSIGNAL_HTTP_PORT=8090\n"
        },
        {
          "path": "start.sh",
          "mode": "0755",
          "content": "#!/usr/bin/env bash\nset -Eeuo pipefail\nROOT=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\ncd \"$ROOT\"\nif [[ -f runconfig.sh ]]; then\n  exec bash runconfig.sh\nfi\nif [[ -f .env ]]; then\n  set -a\n  source .env\n  set +a\nfi\n: \"${SIGNAL_ACCOUNT:?Set SIGNAL_ACCOUNT in .env before starting signal-cli}\"\nexec signal-cli --account \"$SIGNAL_ACCOUNT\" daemon --http \"${SIGNAL_HTTP_HOST:-127.0.0.1}:${SIGNAL_HTTP_PORT:-8090}\"\n"
        }
      ],
      "launch": ["bash", "start.sh"],
      "tmux_session": "diogenes-signal-cli",
      "update_module": "src.ulysses_signal_update",
      "update_args": ["--install-user"],
      "git_update": false,
      "readiness_checks": [
        {
          "label": "signal-cli command",
          "command": "signal-cli",
          "executable": true
        }
      ],
      "ports": [8090]
    },
