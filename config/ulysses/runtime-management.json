{
  "schema_version": "ulysses.runtime-management.v1",
  "runtimes": [
    {
      "id": "firecrawl.api",
      "label": "Firecrawl",
      "category": "docker",
      "capability_group": "search",
      "role": "Hermes search frontend",
      "depends_on": ["searxng.search"],
      "root": "${ULYSSES_MICROSERVICES_ROOT}/firecrawl/firecrawl",
      "compose": "docker-compose.yaml",
      "env_files": [".env"],
      "git_update": true,
      "source_url": "https://github.com/firecrawl/firecrawl",
      "source_branch": "main",
      "build_on_update": true,
      "ports": [3002]
    },
    {
      "id": "searxng.search",
      "label": "SearXNG",
      "category": "docker",
      "capability_group": "search",
      "role": "Firecrawl search backend",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/SEARXNG/searxng",
      "compose": "docker-compose.yml",
      "env_files": [".env"],
      "git_update": false,
      "build_on_update": false,
      "ports": [7070]
    },
    {
      "id": "chroma.vector",
      "label": "Chroma",
      "category": "docker",
      "root": "${HOME}/Odysseus/odysseus",
      "compose": "docker-compose.yml",
      "env_files": [".env"],
      "compose_services": ["chromadb"],
      "git_update": false,
      "build_on_update": false,
      "update_blocked_reason": "Chroma image updates are disabled until the active /data store has a verified durable snapshot and mount.",
      "ports": [8100]
    },
    {
      "id": "camofox.browser",
      "label": "Camofox browser",
      "category": "javascript",
      "capability_group": "browser",
      "role": "Shared Odysseus and Hermes browser backend",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/camofox/camofox-browser",
      "package_json": "package.json",
      "env_files": [],
      "launch": ["bun", "start"],
      "tmux_session": "ulysses-camofox-browser",
      "git_update": true,
      "source_url": "https://github.com/jo-inc/camofox-browser",
      "source_branch": "master",
      "build_script": "build",
      "ports": [9377]
    },
    {
      "id": "bifrost.gateway",
      "label": "Bifrost inference gateway",
      "category": "javascript",
      "capability_group": "cloud-inference",
      "role": "Cloud model proxy",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/bifrost",
      "env_files": [".env"],
      "config_files": [
        {"path": "config.json", "format": "json"},
        {"path": "startup.sh", "format": "shell"}
      ],
      "launch": ["bash", "startup.sh"],
      "tmux_session": "ulysses-bifrost",
      "package_spec": "@maximhq/bifrost@latest",
      "git_update": false,
      "ports": [7999]
    },
    {
      "id": "context.mode.mcp",
      "label": "Context Mode",
      "category": "javascript",
      "capability_group": "context",
      "role": "Hermes context and archive MCP",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/context-mode",
      "package_json": "package.json",
      "env_files": [],
      "git_update": true,
      "source_url": "https://github.com/CommanderTurtle/context-mode.git",
      "source_branch": "main",
      "build_script": "build",
      "hermes_mcp": true,
      "ports": []
    },
    {
      "id": "camofox.mcp",
      "label": "Camofox MCP",
      "category": "javascript",
      "capability_group": "browser",
      "role": "Hermes advanced browser MCP",
      "depends_on": ["camofox.browser"],
      "root": "${ULYSSES_MICROSERVICES_ROOT}/camofox-mcp",
      "package_json": "package.json",
      "env_files": [],
      "git_update": true,
      "source_url": "https://github.com/redf0x1/camofox-mcp.git",
      "source_branch": "main",
      "build_script": "build",
      "hermes_mcp": true,
      "ports": []
    },
    {
      "id": "firecrawl.cli",
      "label": "Firecrawl CLI",
      "category": "javascript",
      "capability_group": "search",
      "role": "Scriptable Firecrawl CLI",
      "depends_on": ["firecrawl.api"],
      "root": "${ULYSSES_MICROSERVICES_ROOT}/firecrawl/cli",
      "package_json": "package.json",
      "env_files": [],
      "git_update": true,
      "source_url": "https://github.com/firecrawl/cli",
      "source_branch": "main",
      "build_script": "build",
      "ports": []
    },
    {
      "id": "signal.cli",
      "label": "signal-cli",
      "category": "native",
      "capability_group": "messaging",
      "role": "Interactive Signal backend",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/signal-cli",
      "env_files": [],
      "config_files": [{"path": "runconfig.sh", "format": "shell"}],
      "launch": ["bash", "runconfig.sh"],
      "tmux_session": "ulysses-signal-cli",
      "update_module": "src.ulysses_signal_update",
      "update_args": ["--install-user"],
      "git_update": false,
      "ports": [8090]
    }
  ]
}
