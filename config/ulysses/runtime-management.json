{
  "schema_version": "ulysses.runtime-management.v1",
  "runtimes": [
    {
      "id": "firecrawl.api",
      "label": "Firecrawl",
      "category": "docker",
      "capability_group": "search",
      "role": "Hermes search frontend",
      "depends_on": ["searxng.search"],
      "root": "${ULYSSES_MICROSERVICES_ROOT}/firecrawl/firecrawl",
      "compose": "docker-compose.yaml",
      "compose_services": ["api"],
      "lifecycle_services": [],
      "update_services": [],
      "env_files": [".env"],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Diogenes Firecrawl local search defaults\nPORT=3002\nHOST=0.0.0.0\nUSE_DB_AUTHENTICATION=false\nSEARXNG_ENDPOINT=http://host.docker.internal:7070\n"
        }
      ],
      "git_update": true,
      "source_url": "https://github.com/firecrawl/firecrawl",
      "source_branch": "main",
      "build_on_update": true,
      "ports": [3002]
    },
    {
      "id": "searxng.search",
      "label": "SearXNG",
      "category": "docker",
      "capability_group": "search",
      "role": "Firecrawl search backend",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/SEARXNG/searxng",
      "compose": "container/docker-compose.yml",
      "compose_fallbacks": ["docker-compose.yml"],
      "compose_services": ["core"],
      "update_services": ["core", "valkey"],
      "env_files": [".env", "container/.env"],
      "config_files": [
        {"path": "container/core-config/settings.yml", "format": "text"}
      ],
      "data_directories": ["container/core-config"],
      "bootstrap_files": [
        {
          "path": "container/.env",
          "mode": "0600",
          "content": "# Official SearXNG container settings for a loopback workstation\nSEARXNG_VERSION=latest\nSEARXNG_HOST=127.0.0.1\nSEARXNG_PORT=7070\n"
        },
        {
          "path": "container/core-config/settings.yml",
          "mode": "0644",
          "content": "# Diogenes enables the JSON format required by Firecrawl while retaining upstream defaults.\nuse_default_settings: true\nsearch:\n  formats:\n    - html\n    - json\n"
        }
      ],
      "git_update": true,
      "allow_non_git_compose": true,
      "source_url": "https://github.com/searxng/searxng.git",
      "source_branch": "master",
      "build_on_update": false,
      "ports": [7070]
    },
    {
      "id": "chroma.vector",
      "label": "Chroma",
      "category": "docker",
      "root": "${ULYSSES_REPOSITORY_ROOT}",
      "compose": "docker-compose.yml",
      "env_files": [".env"],
      "compose_services": ["chromadb"],
      "git_update": false,
      "build_on_update": false,
      "update_blocked_reason": "Chroma image updates are disabled until the active /data store has a verified durable snapshot and mount.",
      "ports": [8100]
    },
    {
      "id": "camofox.browser",
      "label": "Camofox browser",
      "category": "javascript",
      "capability_group": "browser",
      "role": "Shared Odysseus and Hermes browser backend",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/camofox/camofox-browser",
      "package_json": "package.json",
      "env_files": [".env"],
      "config_files": [{"path": "start.sh", "format": "shell"}],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Camofox browser environment\nCAMOFOX_PORT=9377\nCAMOUFOX_INSTALL_DIR=${HOME}/.cache/camoufox\nCAMOFOX_CRASH_REPORT_ENABLED=false\n"
        },
        {
          "path": "start.sh",
          "mode": "0755",
          "content": "#!/usr/bin/env bash\nset -Eeuo pipefail\nROOT=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\ncd \"$ROOT\"\nif [[ -f .env ]]; then\n  set -a\n  source .env\n  set +a\nfi\nexec bun start\n"
        }
      ],
      "launch": ["bash", "start.sh"],
      "tmux_session": "ulysses-camofox-browser",
      "git_update": true,
      "source_url": "https://github.com/jo-inc/camofox-browser",
      "source_branch": "master",
      "build_script": "build",
      "bun_install_mode": "foreign_lock",
      "setup": {
        "kind": "bun_script",
        "value": "fetch-bin"
      },
      "setup_on_update": true,
      "readiness_checks": [
        {
          "label": "Camoufox browser engine",
          "path": "${HOME}/.cache/camoufox/camoufox-bin",
          "executable": true
        }
      ],
      "ports": [9377]
    },
    {
      "id": "bifrost.gateway",
      "label": "Bifrost inference gateway",
      "category": "javascript",
      "capability_group": "cloud-inference",
      "role": "Cloud model proxy",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/bifrost",
      "env_files": [".env"],
      "config_files": [
        {"path": "config.json", "format": "json"},
        {"path": "start.sh", "format": "shell"}
      ],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Bifrost host settings\nBIFROST_HOST=0.0.0.0\nBIFROST_PORT=7999\n"
        },
        {
          "path": "start.sh",
          "mode": "0755",
          "content": "#!/usr/bin/env bash\nset -Eeuo pipefail\nROOT=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\ncd \"$ROOT\"\nif [[ -f .env ]]; then\n  set -a\n  source .env\n  set +a\nfi\nexec bun x @maximhq/bifrost@latest -app-dir . -port \"${BIFROST_PORT:-7999}\" -host \"${BIFROST_HOST:-127.0.0.1}\"\n"
        },
        {
          "path": "config.json",
          "mode": "0600",
          "content": "{\n  \"$schema\": \"https://www.getbifrost.ai/schema\",\n  \"client\": {\n    \"enforce_auth_on_inference\": true,\n    \"drop_excess_requests\": true\n  },\n  \"providers\": {}\n}\n"
        }
      ],
      "launch": ["bash", "start.sh"],
      "tmux_session": "ulysses-bifrost",
      "package_spec": "@maximhq/bifrost@latest",
      "git_update": false,
      "dashboard": {
        "label": "Open Bifrost",
        "url": "http://127.0.0.1:7999"
      },
      "ports": [7999]
    },
    {
      "id": "context.mode.mcp",
