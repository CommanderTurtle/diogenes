{
  "schema_version": "ulysses.runtime-management.v1",
  "runtimes": [
    {
      "id": "firecrawl.api",
      "label": "Firecrawl",
      "category": "docker",
      "dependency_section": "Search",
      "recommended": true,
      "capability_group": "search",
      "role": "Hermes search frontend",
      "integration": "hermes-firecrawl",
      "depends_on": ["searxng.search"],
      "root": "${ULYSSES_MICROSERVICES_ROOT}/firecrawl/firecrawl",
      "compose": "docker-compose.yaml",
      "compose_services": ["api"],
      "lifecycle_services": [],
      "update_services": [],
      "env_files": [".env"],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Firecrawl local search defaults\nPORT=3002\nHOST=0.0.0.0\nUSE_DB_AUTHENTICATION=false\nFIRECRAWL_DISABLE_AUTH=true\nALLOW_LOCAL_WEBHOOKS=true\nSEARCH_BACKEND=searxng\nSEARXNG_ENDPOINT=http://host.docker.internal:7070\nPLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape\nREDIS_URL=redis://redis:6379\nREDIS_RATE_LIMIT_URL=redis://redis:6379\nPOSTGRES_USER=postgres\nPOSTGRES_PASSWORD=postgres\nPOSTGRES_DB=postgres\n# Optional OpenAI-compatible extraction model:\n# OPENAI_BASE_URL=http://host.docker.internal:8000/v1\n# OPENAI_API_KEY=local\n# MODEL_NAME=\n"
        }
      ],
      "git_update": true,
      "source_url": "https://github.com/firecrawl/firecrawl",
      "source_branch": "main",
      "build_on_update": true,
      "ports": [3002]
    },
    {
      "id": "searxng.search",
      "label": "SearXNG",
      "category": "docker",
      "dependency_section": "Search",
      "recommended": true,
      "capability_group": "search",
      "role": "Firecrawl search backend",
      "integration": "diogenes-searxng",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/SEARXNG/searxng",
      "compose": "docker-compose.yml",
      "compose_fallbacks": ["container/docker-compose.yml"],
      "compose_services": ["core"],
      "update_services": ["core", "valkey"],
      "env_files": [".env", "container/.env"],
      "config_files": [
        {"path": "core-config/settings.yml", "format": "text"},
        {"path": "container/core-config/settings.yml", "format": "text"}
      ],
      "data_directories": ["core-config"],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Official SearXNG container settings for a loopback workstation\nSEARXNG_VERSION=latest\nSEARXNG_HOST=127.0.0.1\nSEARXNG_PORT=7070\n"
        },
        {
          "path": "core-config/settings.yml",
          "mode": "0644",
          "content": "# Firecrawl requires SearXNG's JSON response format.\nuse_default_settings: true\nserver:\n  bind_address: \"0.0.0.0\"\n  port: 7070\n  secret_key: \"replace-this-local-secret\"\nsearch:\n  formats:\n    - html\n    - json\n"
        },
        {
          "path": "docker-compose.yml",
          "mode": "0644",
          "content": "name: searxng\n\nservices:\n  core:\n    container_name: searxng-core\n    image: docker.io/searxng/searxng:${SEARXNG_VERSION:-latest}\n    restart: unless-stopped\n    ports:\n      - \"${SEARXNG_HOST:-127.0.0.1}:${SEARXNG_PORT:-7070}:${SEARXNG_PORT:-7070}\"\n    env_file: ./.env\n    volumes:\n      - ./core-config/:/etc/searxng/:Z\n      - core-data:/var/cache/searxng/\n\n  valkey:\n    container_name: searxng-valkey\n    image: docker.io/valkey/valkey:9-alpine\n    command: valkey-server --save 30 1 --loglevel warning\n    restart: unless-stopped\n    volumes:\n      - valkey-data:/data/\n\nvolumes:\n  core-data:\n  valkey-data:\n"
        }
      ],
      "git_update": false,
      "allow_non_git_compose": true,
      "build_on_update": false,
      "ports": [7070]
    },
    {
