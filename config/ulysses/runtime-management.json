    {
      "id": "signal.cli",
      "label": "signal-cli",
      "category": "native",
      "capability_group": "messaging",
      "role": "Interactive Signal backend",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/signal-cli",
      "env_files": [".env"],
      "config_files": [
        {"path": "start.sh", "format": "shell"},
        {"path": "runconfig.sh", "format": "shell"}
      ],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Used when no legacy runconfig.sh exists.\nSIGNAL_ACCOUNT=\nSIGNAL_HTTP_HOST=127.0.0.1\nSIGNAL_HTTP_PORT=8090\n"
        },
        {
          "path": "start.sh",
          "mode": "0755",
          "content": "#!/usr/bin/env bash\nset -Eeuo pipefail\nROOT=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\ncd \"$ROOT\"\nif [[ -f runconfig.sh ]]; then\n  exec bash runconfig.sh\nfi\nif [[ -f .env ]]; then\n  set -a\n  source .env\n  set +a\nfi\n: \"${SIGNAL_ACCOUNT:?Set SIGNAL_ACCOUNT in .env before starting signal-cli}\"\nexec signal-cli --account \"$SIGNAL_ACCOUNT\" daemon --http \"${SIGNAL_HTTP_HOST:-127.0.0.1}:${SIGNAL_HTTP_PORT:-8090}\"\n"
        }
      ],
      "launch": ["bash", "start.sh"],
      "tmux_session": "ulysses-signal-cli",
      "update_module": "src.ulysses_signal_update",
      "update_args": ["--install-user"],
      "git_update": false,
      "readiness_checks": [
        {
          "label": "signal-cli command",
          "path": "${HOME}/.local/bin/signal-cli",
          "executable": true
        }
      ],
      "ports": [8090]
    },
    {
      "id": "n8n.automation",
      "label": "n8n",
      "category": "docker",
      "resource_kind": "service",
      "capability_group": "automation",
      "role": "Local workflow and automation service",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/n8n",
      "compose": "compose.yml",
      "compose_services": ["n8n"],
      "env_files": [".env"],
      "data_directories": ["data"],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# n8n local workstation settings\nN8N_IMAGE=docker.n8n.io/n8nio/n8n:2.31.6\nN8N_BIND_ADDRESS=127.0.0.1\nN8N_PORT=5678\nN8N_HOST=localhost\nN8N_PROTOCOL=http\nN8N_SECURE_COOKIE=false\nN8N_DIAGNOSTICS_ENABLED=false\nN8N_VERSION_NOTIFICATIONS_ENABLED=false\nN8N_TEMPLATES_ENABLED=false\nN8N_PERSONALIZATION_ENABLED=false\nN8N_HIRING_BANNER_ENABLED=false\nN8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true\nGENERIC_TIMEZONE=UTC\n"
        },
        {
          "path": "compose.yml",
          "mode": "0644",
          "content": "services:\n  n8n:\n    image: \"${N8N_IMAGE:-docker.n8n.io/n8nio/n8n:2.31.6}\"\n    restart: unless-stopped\n    ports:\n      - \"${N8N_BIND_ADDRESS:-127.0.0.1}:${N8N_PORT:-5678}:5678\"\n    environment:\n      N8N_HOST: \"${N8N_HOST:-localhost}\"\n      N8N_PORT: \"5678\"\n      N8N_PROTOCOL: \"${N8N_PROTOCOL:-http}\"\n      N8N_SECURE_COOKIE: \"${N8N_SECURE_COOKIE:-false}\"\n      N8N_DIAGNOSTICS_ENABLED: \"${N8N_DIAGNOSTICS_ENABLED:-false}\"\n      N8N_VERSION_NOTIFICATIONS_ENABLED: \"${N8N_VERSION_NOTIFICATIONS_ENABLED:-false}\"\n      N8N_TEMPLATES_ENABLED: \"${N8N_TEMPLATES_ENABLED:-false}\"\n      N8N_PERSONALIZATION_ENABLED: \"${N8N_PERSONALIZATION_ENABLED:-false}\"\n      N8N_HIRING_BANNER_ENABLED: \"${N8N_HIRING_BANNER_ENABLED:-false}\"\n      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: \"${N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS:-true}\"\n      GENERIC_TIMEZONE: \"${GENERIC_TIMEZONE:-UTC}\"\n    volumes:\n      - ./data:/home/node/.n8n\n"
        }
      ],
      "git_update": false,
      "build_on_update": false,
      "optional": true,
      "dashboard": {
        "label": "Open n8n",
        "url": "http://127.0.0.1:5678"
      },
      "ports": [5678]
    }
  ]
}
