          "label": "Firecrawl command",
          "path": "${HOME}/.bun/bin/firecrawl",
          "executable": true
        }
      ],
      "ports": []
    },
    {
      "id": "hermes.workspace",
      "label": "Hermes Workspace",
      "category": "javascript",
      "resource_kind": "service",
      "capability_group": "agent-control",
      "role": "Hermes orchestration dashboard",
      "root": "${ULYSSES_MICROSERVICES_ROOT}/hermes-workspace",
      "package_json": "package.json",
      "env_files": [".env"],
      "config_files": [
        {"path": "start.sh", "format": "shell"},
        {"path": "run.sh", "format": "shell"},
        {"path": "update.sh", "format": "shell"}
      ],
      "bootstrap_files": [
        {
          "path": ".env",
          "mode": "0600",
          "content": "# Hermes Workspace local-only defaults\nHOST=127.0.0.1\nPORT=3003\nHERMES_API_URL=http://127.0.0.1:8642\nHERMES_DASHBOARD_URL=http://127.0.0.1:9119\nCOOKIE_SECURE=0\nVITE_HERMESWORLD_ENABLED=0\nVITE_PLAYGROUND_WS_URL=\nVITE_PLAYGROUND_STATS_URL=\n"
        },
        {
          "path": "run.sh",
          "mode": "0755",
          "content": "#!/usr/bin/env bash\nset -Eeuo pipefail\nROOT=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\ncd \"$ROOT\"\nif [[ -f .env ]]; then\n  set -a\n  source .env\n  set +a\nfi\nHERMES_HOME=\"${HERMES_HOME:-$HOME/.hermes}\"\nif [[ -z ${HERMES_API_TOKEN:-} && -r \"$HERMES_HOME/.env\" ]]; then\n  HERMES_API_TOKEN=\"$(sed -n 's/^API_SERVER_KEY=//p' \"$HERMES_HOME/.env\" | tail -n 1)\"\n  HERMES_API_TOKEN=\"${HERMES_API_TOKEN%\\\"}\"\n  HERMES_API_TOKEN=\"${HERMES_API_TOKEN#\\\"}\"\n  export HERMES_API_TOKEN\nfi\nexec bun server-entry.js\n"
        }
      ],
      "launch": ["bash", "run.sh"],
      "tmux_session": "hermes-workspace",
      "git_update": true,
      "source_url": "https://github.com/outsourc-e/hermes-workspace.git",
      "source_branch": "main",
      "build_script": "build",
      "bun_install_mode": "pnpm_lock",
      "dashboard": {
        "label": "Open Hermes Workspace",
        "url": "http://127.0.0.1:3003"
      },
      "ports": [3003]
    },
