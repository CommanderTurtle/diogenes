    {
      "id": "firecrawl.cli",
      "label": "Firecrawl CLI",
      "category": "javascript",
      "resource_kind": "repository",
      "capability_group": "search",
      "role": "Scriptable Firecrawl CLI",
      "depends_on": ["firecrawl.api"],
      "root": "${ULYSSES_MICROSERVICES_ROOT}/firecrawl/cli",
      "package_json": "package.json",
      "env_files": [],
      "git_update": true,
      "source_url": "https://github.com/firecrawl/cli",
      "source_branch": "main",
      "build_script": "build",
      "bun_install_mode": "pnpm_lock",
      "setup": {
        "kind": "bun_global",
        "value": "."
      },
      "setup_on_update": true,
      "readiness_checks": [
