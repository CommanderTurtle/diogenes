    {
      "id": "librarian",
      "directory": "librarian",
      "source": "https://github.com/CommanderTurtle/librarian.git",
      "role": "Hermes-delegated OKF librarian MCP"
    },
    {
      "id": "retrieval",
      "directory": "retrieval",
      "source": "https://github.com/CommanderTurtle/retrieval.git",
      "role": "Dual Hermes and OMP cold-skill discovery through isolated projections, an IWE graph, Chroma ranking, and an ephemeral OMP scout"
    },
    {
      "id": "context-mode",
      "directory": "context-mode",
      "source": "https://github.com/ildunari/context-mode.git",
      "branch": "feat/hermes-native-support",
      "upstream_pr": "https://github.com/mksglu/context-mode/pull/1010",
      "role": "Native Hermes context protection plugin and MCP"
    },
    {
      "id": "camofox-mcp",
      "directory": "camofox-mcp",
      "source": "https://github.com/redf0x1/camofox-mcp.git",
