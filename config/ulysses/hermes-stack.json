{
  "schema_version": "diogenes.hermes-stack.v1",
  "integration_model": "repository-owned-scripts",
  "repositories": [
    {
      "id": "localflame",
      "directory": "${HOME}/Deepseek/localflame",
      "source": "https://github.com/CommanderTurtle/localflame",
      "role": "Firecrawl MCP for OMP, Hermes, and DSH"
    },
    {
      "id": "librarian",
      "directory": "librarian",
      "source": "https://github.com/CommanderTurtle/librarian.git",
      "role": "Public knowledge MCP with an isolated Hermes worker"
    },
    {
      "id": "retrieval",
      "directory": "retrieval",
      "source": "https://github.com/CommanderTurtle/retrieval.git",
      "role": "Cold-skill discovery, internal graph navigation, isolated projections, and session-close indexing"
    },
    {
      "id": "context-mode",
      "directory": "context-mode",
      "source": "https://github.com/ildunari/context-mode.git",
      "branch": "feat/hermes-native-support",
      "role": "Context Mode MCP and native Hermes plugin"
    },
    {
      "id": "camofox-mcp",
      "directory": "camofox-mcp",
      "source": "https://github.com/redf0x1/camofox-mcp.git",
      "role": "Camofox browser MCP"
    },
    {
      "id": "codebase-memory-mcp",
      "directory": "codebase-memory-mcp",
      "source": "https://github.com/DeusData/codebase-memory-mcp.git",
      "role": "Structural code graph MCP and Hermes hook"
    },
    {
      "id": "persephone",
      "directory": "persephone",
      "source": "https://github.com/CommanderTurtle/persephone.git",
      "role": "OMP gateway, scheduler, connector, and RPC supervisor"
    },
    {
      "id": "leetcoder",
      "directory": "leetcoder",
      "source": "https://github.com/CommanderTurtle/leetcoder.git",
      "role": "Hermes-to-OMP delegation MCP"
    }
  ],
  "profile_policy": {
    "ordinary_profiles": "discovered and reconciled by each repository owner",
    "private_librarian_profile": "librarian-okf only",
    "skills": "clean harness baseline plus Retrieval routing",
    "provider_preferences": "preserved"
  },
  "gateway_restart_required": true
}
