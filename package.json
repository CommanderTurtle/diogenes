{
  "name": "diogenes-control-plane",
  "private": true,
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/CommanderTurtle/diogenes.git"
  },
  "scripts": {
    "js:check": "bun scripts/check-js-syntax.mjs",
    "deps:check": "bun outdated",
    "deps:audit": "bun audit",
    "deps:update": "bun update",
    "test:photo-editor": "playwright test --config tests/e2e/playwright.config.js",
    "test:photo-editor:install": "playwright install chromium firefox webkit",
    "test:photo-editor:firefox": "PHOTO_EDITOR_E2E_BROWSER=firefox playwright test --config tests/e2e/playwright.config.js",
    "test:photo-editor:webkit": "PHOTO_EDITOR_E2E_BROWSER=webkit playwright test --config tests/e2e/playwright.config.js",
    "test:ios-layout": "playwright test --config tests/e2e/ios-layout.config.cjs",
    "test:ios-layout:chromium": "ODYSSEUS_LAYOUT_BROWSER=chromium playwright test --config tests/e2e/ios-layout.config.cjs",
    "test:ios-layout:webkit": "ODYSSEUS_LAYOUT_BROWSER=webkit playwright test --config tests/e2e/ios-layout.config.cjs",
    "test:ios-layout:install": "playwright install chromium webkit"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "^0.7.0",
    "@playwright/test": "^1.62.1",
    "acorn": "8.19.0"
  }
}
