#!/usr/bin/env python3
"""Prepare a disposable Ulysses runtime from a clean development checkout.

The source checkout remains PR-ready. Runtime state lives in a separate,
private directory and is attached to the disposable checkout through its
ignored ``.env`` file:

    ./scripts/ulysses-deploy inspect
    ./scripts/ulysses-deploy prepare
    ./scripts/ulysses-deploy capture
    ./scripts/ulysses-deploy attach-state
    ./scripts/ulysses-deploy venv

``capture`` refuses to read from a running production tree by default. This
keeps JSON state and SQLite databases at one cutover point. ``--allow-running``
is available for an initial preview snapshot; SQLite files still use the
online-backup API in that mode.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path


SOURCE_ROOT = Path(__file__).resolve().parents[1]
ODYSSEUS_ROOT = SOURCE_ROOT.parent
DEFAULT_PRODUCTION_ROOT = ODYSSEUS_ROOT / "odysseus"
DEFAULT_RUNTIME_ROOT = ODYSSEUS_ROOT / "Ulysses-build"
DEFAULT_STATE_ROOT = ODYSSEUS_ROOT / "Ulysses-state"

SQLITE_SUFFIXES = {".db", ".sqlite", ".sqlite3"}
DURABLE_FILE_SUFFIXES = SQLITE_SUFFIXES | {".json", ".md"}
DURABLE_FILE_NAMES = {".app_key"}
DURABLE_DIRS = {
    "bg_jobs",
    "chroma",
    "deep_research",
    "gallery",
    "gallery_uploads",
    "generated_images",
    "mail-attachments",
    "mcp_oauth",
    "memory_vectors",
    "personal_docs",
    "personal_uploads",
    "rag",
    "skills",
    "uploads",
}
KNOWN_REBUILDABLE_DIRS = {
    ".bun",
    ".cargo",
    ".local",
    ".rustup",
    "bin",
    "cache",
    "chromadb-container-safety-20260725T0000",
    "email_urgency_cache",
    "emoji_cache",
    "fastembed_cache",
    "hwfit",
    "local",
    "logs",
    "tts_cache",
}
CRITICAL_PACKAGES = (
    "vllm",
    "torch",
    "transformers",
    "onnxruntime-gpu",
    "fastembed",
    "chromadb-client",
    "numpy",
    "triton",
)


class DeployError(RuntimeError):
    """An actionable deployment-contract failure."""


def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _emit(payload: dict, pretty: bool = False) -> None:
    print(json.dumps(payload, indent=2 if pretty else None, sort_keys=True))


def _run(
    argv: list[str],
    *,
    cwd: Path | None = None,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    proc = subprocess.run(
        argv,
        cwd=str(cwd) if cwd else None,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
    )
    if check and proc.returncode:
        detail = (proc.stderr or proc.stdout).strip()
        raise DeployError(f"{' '.join(argv)} failed ({proc.returncode}): {detail}")
    return proc


def _git(root: Path, *args: str, check: bool = True) -> str:
    return _run(["git", "-C", str(root), *args], check=check).stdout.strip()


def _is_relative_to(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def _validate_state_target(
    state_root: Path,
    *,
    source_root: Path,
    production_root: Path,
    runtime_root: Path,
) -> None:
    resolved = state_root.resolve()
    forbidden_exact = {
        Path("/"),
        Path.home().resolve(),
        source_root.resolve(),
        production_root.resolve(),
        runtime_root.resolve(),
    }
    if resolved in forbidden_exact:
        raise DeployError(f"unsafe state target: {resolved}")
    for tree in (source_root, production_root, runtime_root):
        if _is_relative_to(resolved, tree.resolve()):
            raise DeployError(f"state target must be outside checkout/runtime trees: {resolved}")


def source_contract(source_root: Path) -> dict:
    """Return source provenance, refusing a dirty or non-dev checkout."""
    if not (source_root / ".git").exists():
        raise DeployError(f"source is not a Git checkout: {source_root}")
    dirty = _git(source_root, "status", "--porcelain", "--untracked-files=all")
    if dirty:
        raise DeployError("source checkout is dirty; commit or remove every change before preparing a runtime")
    branch = _git(source_root, "branch", "--show-current")
    if branch != "dev":
        raise DeployError(f"source branch must be dev, found {branch or 'detached HEAD'}")
    head = _git(source_root, "rev-parse", "HEAD")
    upstream = _git(source_root, "rev-parse", "--verify", "upstream/dev")
    ancestor = _run(
        ["git", "-C", str(source_root), "merge-base", "--is-ancestor", upstream, head],
        check=False,
    ).returncode == 0
    if not ancestor:
        raise DeployError("upstream/dev is not an ancestor of source HEAD")
    return {
        "root": str(source_root.resolve()),
        "branch": branch,
        "head": head,
        "upstream_dev": upstream,
        "ahead": int(_git(source_root, "rev-list", "--count", f"{upstream}..{head}")),
        "clean": True,
    }


def _active_production_pids(production_root: Path) -> list[int]:
    """Find application processes that can mutate production state.

    An authenticated shell may remain parked in the production directory after
    the server stops. Its cwd alone is not a writer and must not block cutover.
    Match known Odysseus launch/child-process markers as well as the checkout
    path so Uvicorn and bundled MCP children remain a hard gate.
    """
    root = str(production_root.resolve())
    app_markers = (
        "uvicorn",
        "gunicorn",
        "launcher.py",
        "app.py",
        "mcp_servers/",
    )
    found: set[int] = set()
    proc_root = Path("/proc")
    if not proc_root.is_dir():
        return []
    for item in proc_root.iterdir():
        if not item.name.isdigit():
            continue
        try:
            pid = int(item.name)
            cwd = os.readlink(item / "cwd")
            cmdline = (item / "cmdline").read_bytes().replace(b"\0", b" ").decode(
                "utf-8", errors="replace"
            )
        except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
            continue
        references_root = cwd == root or cwd.startswith(root + os.sep) or root in cmdline
        if references_root and any(marker in cmdline for marker in app_markers):
            found.add(pid)
    return sorted(found)


def _path_size(path: Path) -> int:
    if path.is_symlink():
        return 0
    if path.is_file():
        return path.stat().st_size
    total = 0
    for candidate in path.rglob("*"):
        try:
            if candidate.is_file() and not candidate.is_symlink():
                total += candidate.stat().st_size
        except FileNotFoundError:
            continue
    return total


def _production_data_root(production_root: Path, explicit: Path | None) -> Path:
    if explicit:
        return explicit.expanduser().resolve()
    return (production_root / "data").resolve()


def state_inventory(production_root: Path, production_data: Path | None = None) -> dict:
    data_root = _production_data_root(production_root, production_data)
    if not data_root.is_dir():
        raise DeployError(f"production data directory is missing: {data_root}")
    selected: list[dict] = []
    excluded: list[dict] = []
    for path in sorted(data_root.iterdir(), key=lambda item: item.name):
        if path.is_symlink():
            excluded.append({"name": path.name, "bytes": 0, "reason": "symlink"})
            continue
        durable = (
            (path.is_file() and (path.name in DURABLE_FILE_NAMES or path.suffix in DURABLE_FILE_SUFFIXES))
            or (path.is_dir() and path.name in DURABLE_DIRS)
        )
        entry = {"name": path.name, "bytes": _path_size(path), "kind": "dir" if path.is_dir() else "file"}
        if durable:
            selected.append(entry)
        else:
            entry["reason"] = "rebuildable" if path.name in KNOWN_REBUILDABLE_DIRS else "not in durable allowlist"
            excluded.append(entry)
    env_path = production_root / ".env"
    return {
        "production_root": str(production_root.resolve()),
        "data_root": str(data_root),
        "environment_file": {
            "path": str(env_path.resolve()),
            "present": env_path.is_file(),
            "bytes": env_path.stat().st_size if env_path.is_file() else 0,
        },
        "active_pids": _active_production_pids(production_root),
        "selected": selected,
        "selected_bytes": sum(item["bytes"] for item in selected),
        "excluded": excluded,
        "excluded_bytes": sum(item["bytes"] for item in excluded),
    }


def _sqlite_safe_copy(source: Path, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    source_conn = sqlite3.connect(f"file:{source}?mode=ro", uri=True)
    destination_conn = sqlite3.connect(str(destination))
    try:
        with destination_conn:
            source_conn.backup(destination_conn)
    finally:
        source_conn.close()
        destination_conn.close()


def _copy_file(source: Path, destination: Path) -> None:
    if source.suffix in SQLITE_SUFFIXES:
        _sqlite_safe_copy(source, destination)
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination, follow_symlinks=False)


def _copy_durable_entry(source: Path, destination: Path) -> None:
    if source.is_file():
        _copy_file(source, destination)
        return
    destination.mkdir(parents=True, exist_ok=True)
    for item in source.rglob("*"):
        relative = item.relative_to(source)
        target = destination / relative
        if item.is_symlink():
            raise DeployError(f"refusing durable-state symlink: {item}")
        if item.is_dir():
            target.mkdir(parents=True, exist_ok=True)
        elif item.is_file():
            _copy_file(item, target)


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def _snapshot_files(root: Path) -> list[dict]:
    files = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            files.append(
                {
                    "path": str(path.relative_to(root)),
                    "bytes": path.stat().st_size,
                    "sha256": _sha256(path),
                }
            )
    return files


def _capture_environment(production_root: Path) -> dict:
    venv = production_root / ".venv"
    payload: dict = {
        "venv": str(venv),
        "pyvenv_cfg": (venv / "pyvenv.cfg").read_text(encoding="utf-8") if (venv / "pyvenv.cfg").is_file() else None,
        "packages": {},
    }
    python = venv / "bin" / "python"
    if not python.is_file():
        return payload
    script = (
        "import importlib.metadata as m,json;"
        f"names={list(CRITICAL_PACKAGES)!r};"
        "print(json.dumps({n:(m.version(n) if any(d.metadata.get('Name','').lower()==n.lower() for d in m.distributions()) else None) for n in names}))"
    )
    probe = _run([str(python), "-c", script], check=False)
    if probe.returncode == 0:
        try:
            payload["packages"] = json.loads(probe.stdout)
        except json.JSONDecodeError:
            payload["probe_error"] = "invalid package probe output"
    else:
        payload["probe_error"] = (probe.stderr or probe.stdout).strip()
    return payload


def _render_runtime_env(source_env: Path, data_root: Path) -> str:
    text = source_env.read_text(encoding="utf-8-sig") if source_env.is_file() else ""
    lines = [
        line
        for line in text.splitlines()
        if not re.match(r"^\s*ODYSSEUS_DATA_DIR\s*=", line)
    ]
    if lines and lines[-1].strip():
        lines.append("")
    lines.extend(
        [
            "# Managed by scripts/ulysses-deploy; durable state stays outside the disposable checkout.",
            f"ODYSSEUS_DATA_DIR={data_root}",
        ]
    )
    return "\n".join(lines) + "\n"


def capture_state(
    *,
    production_root: Path,
    production_data: Path | None,
    source_root: Path,
    runtime_root: Path,
    state_root: Path,
    replace: bool,
    allow_running: bool,
) -> dict:
    _validate_state_target(
        state_root,
        source_root=source_root,
        production_root=production_root,
        runtime_root=runtime_root,
    )
    inventory = state_inventory(production_root, production_data)
    if inventory["active_pids"] and not allow_running:
        raise DeployError(
            "production is still running; stop it for a single-point snapshot "
            "or pass --allow-running for an online preview snapshot"
        )
    if state_root.exists() and not replace:
        raise DeployError(f"state target already exists: {state_root} (pass --replace)")
    parent = state_root.parent
    parent.mkdir(parents=True, exist_ok=True)
    stage = parent / f".{state_root.name}.next-{uuid.uuid4().hex}"
    previous = parent / f".{state_root.name}.previous-{uuid.uuid4().hex}"
    stage.mkdir(mode=0o700)
    try:
        stage_data = stage / "data"
        stage_data.mkdir(mode=0o700)
        data_root = Path(inventory["data_root"])
        selected_names = {entry["name"] for entry in inventory["selected"]}
        for name in sorted(selected_names):
            _copy_durable_entry(data_root / name, stage_data / name)
        env_text = _render_runtime_env(production_root / ".env", state_root / "data")
        env_target = stage / "ulysses.env"
        env_target.write_text(env_text, encoding="utf-8")
        env_target.chmod(0o600)
        environment = _capture_environment(production_root)
        (stage / "production-environment.json").write_text(
            json.dumps(environment, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        manifest = {
            "schema": 1,
            "captured_at": _utc_now(),
            "online_snapshot": bool(inventory["active_pids"]),
            "production_root": str(production_root.resolve()),
            "production_data": str(data_root),
            "state_root": str(state_root.resolve()),
            "source": source_contract(source_root),
            "inventory": inventory,
            "files": _snapshot_files(stage),
        }
        (stage / "capture-manifest.json").write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        if state_root.exists():
            os.rename(state_root, previous)
        os.rename(stage, state_root)
        if previous.exists():
            shutil.rmtree(previous)
    except Exception:
        if not state_root.exists() and previous.exists():
            os.rename(previous, state_root)
        if stage.exists():
            shutil.rmtree(stage)
        raise
    return {
        "ok": True,
        "state_root": str(state_root.resolve()),
        "data_root": str((state_root / "data").resolve()),
        "selected_bytes": inventory["selected_bytes"],
        "selected_entries": len(inventory["selected"]),
        "online_snapshot": bool(inventory["active_pids"]),
        "next": "Run attach-state, then create the candidate venv.",
    }


def prepare_runtime(source_root: Path, runtime_root: Path, state_root: Path) -> dict:
    provenance = source_contract(source_root)
    if runtime_root.exists():
        raise DeployError(f"runtime target already exists: {runtime_root}")
    runtime_root.parent.mkdir(parents=True, exist_ok=True)
    _run(
        [
            "git",
            "clone",
            "--local",
            "--no-hardlinks",
            "--branch",
            "dev",
            str(source_root.resolve()),
            str(runtime_root.resolve()),
        ]
    )
    try:
        _git(runtime_root, "remote", "rename", "origin", "source")
        _git(runtime_root, "remote", "set-url", "--push", "source", "DISABLED")
        upstream_url = _git(source_root, "config", "--get", "remote.upstream.url", check=False)
        if upstream_url:
            _git(runtime_root, "remote", "add", "upstream", upstream_url)
            _git(runtime_root, "remote", "set-url", "--push", "upstream", "DISABLED")
        manifest = {
            "schema": 1,
            "prepared_at": _utc_now(),
            "source": provenance,
            "runtime_root": str(runtime_root.resolve()),
            "state_root": str(state_root.resolve()),
            "disposable": True,
        }
        git_manifest = runtime_root / ".git" / "ulysses-build.json"
        git_manifest.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        attached = False
        if (state_root / "ulysses.env").is_file():
            attach_state(runtime_root, state_root)
            attached = True
        if _git(runtime_root, "status", "--porcelain", "--untracked-files=all"):
            raise DeployError("prepared runtime is unexpectedly dirty")
    except Exception:
        shutil.rmtree(runtime_root)
        raise
    return {
        "ok": True,
        "runtime_root": str(runtime_root.resolve()),
        "source_head": provenance["head"],
        "state_attached": attached,
        "venv_present": (runtime_root / ".venv").is_dir(),
        "ports_started": [],
    }


def attach_state(runtime_root: Path, state_root: Path) -> dict:
    if not (runtime_root / ".git").is_dir():
        raise DeployError(f"runtime checkout is missing: {runtime_root}")
    state_env = (state_root / "ulysses.env").resolve()
    state_data = (state_root / "data").resolve()
    if not state_env.is_file() or not state_data.is_dir():
        raise DeployError(f"captured state is incomplete: {state_root}")
    target = runtime_root / ".env"
    if target.is_symlink():
        if target.resolve() != state_env:
            raise DeployError(f"runtime .env points somewhere else: {target.resolve()}")
    elif target.exists():
        raise DeployError(f"refusing to replace existing runtime .env: {target}")
    else:
        target.symlink_to(state_env)
    return {
        "ok": True,
        "runtime_env": str(target),
        "state_env": str(state_env),
        "data_root": str(state_data),
    }


def create_venv(runtime_root: Path, python_version: str) -> dict:
    if not (runtime_root / ".git").is_dir():
        raise DeployError(f"runtime checkout is missing: {runtime_root}")
    if not (runtime_root / ".env").is_symlink():
        raise DeployError("attach captured state before creating the runtime environment")
    venv = runtime_root / ".venv"
    if venv.exists():
        raise DeployError(f"runtime venv already exists: {venv}")
    uv = shutil.which("uv")
    if not uv:
        raise DeployError("uv is not available on PATH")
    _run([uv, "venv", str(venv), "--python", python_version, "--seed"], cwd=runtime_root)
    python = venv / "bin" / "python"
    _run(
        [uv, "pip", "install", "--python", str(python), "-r", "requirements.txt"],
        cwd=runtime_root,
    )
    env = os.environ.copy()
    env["ODYSSEUS_SKIP_ADMIN_PROMPT"] = "1"
    _run([str(python), "setup.py"], cwd=runtime_root, env=env)
    check = _run([uv, "pip", "check", "--python", str(python)], cwd=runtime_root, check=False)
    if check.returncode:
        raise DeployError(f"uv pip check failed: {(check.stderr or check.stdout).strip()}")
    return {
        "ok": True,
        "runtime_root": str(runtime_root.resolve()),
        "venv": str(venv.resolve()),
        "python": _run([str(python), "--version"]).stdout.strip(),
        "pip_check": "passed",
        "ports_started": [],
    }


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ulysses-deploy")
    parser.add_argument("--pretty", action="store_true")
    parser.add_argument("--source-root", type=Path, default=SOURCE_ROOT)
    parser.add_argument("--production-root", type=Path, default=DEFAULT_PRODUCTION_ROOT)
    parser.add_argument("--production-data", type=Path)
    parser.add_argument("--runtime-root", type=Path, default=DEFAULT_RUNTIME_ROOT)
    parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("inspect")
    capture = sub.add_parser("capture")
    capture.add_argument("--replace", action="store_true")
    capture.add_argument("--allow-running", action="store_true")
    sub.add_parser("prepare")
    sub.add_parser("attach-state")
    venv = sub.add_parser("venv")
    venv.add_argument("--python", default="3.13.12")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    source_root = args.source_root.expanduser().resolve()
    production_root = args.production_root.expanduser().resolve()
    runtime_root = args.runtime_root.expanduser().resolve()
    state_root = args.state_root.expanduser().resolve()
    production_data = args.production_data.expanduser().resolve() if args.production_data else None
    try:
        if args.command == "inspect":
            payload = {
                "ok": True,
                "source": source_contract(source_root),
                "production": state_inventory(production_root, production_data),
                "runtime": {
                    "root": str(runtime_root),
                    "present": runtime_root.is_dir(),
                    "venv_present": (runtime_root / ".venv").is_dir(),
                },
                "state": {
                    "root": str(state_root),
                    "present": state_root.is_dir(),
                    "env_present": (state_root / "ulysses.env").is_file(),
                    "data_present": (state_root / "data").is_dir(),
                },
            }
        elif args.command == "capture":
            payload = capture_state(
                production_root=production_root,
                production_data=production_data,
                source_root=source_root,
                runtime_root=runtime_root,
                state_root=state_root,
                replace=args.replace,
                allow_running=args.allow_running,
            )
        elif args.command == "prepare":
            payload = prepare_runtime(source_root, runtime_root, state_root)
        elif args.command == "attach-state":
            payload = attach_state(runtime_root, state_root)
        else:
            payload = create_venv(runtime_root, args.python)
        _emit(payload, args.pretty)
        return 0
    except DeployError as exc:
        _emit({"ok": False, "error": str(exc)}, args.pretty)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
