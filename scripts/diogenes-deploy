#!/usr/bin/env python3
"""Prepare a self-contained Diogenes-prod checkout without starting it."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path


SOURCE_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_RUNTIME_ROOT = SOURCE_ROOT.parent / "Diogenes-prod"
EXPECTED_UPSTREAM_URL = "https://github.com/odysseus-dev/odysseus.git"
_GITHUB_REMOTE_RE = re.compile(
    r"^(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)"
    r"([^/\s]+)/([^/\s]+)/?$",
    re.IGNORECASE,
)


class DeployError(RuntimeError):
    """An actionable deployment-contract failure."""


def _run(
    argv: list[str],
    *,
    cwd: Path | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        argv,
        cwd=str(cwd) if cwd else None,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if check and result.returncode:
        detail = (result.stderr or result.stdout).strip()
        raise DeployError(
            f"{' '.join(argv)} failed ({result.returncode}): {detail}"
        )
    return result


def _git(root: Path, *args: str, check: bool = True) -> str:
    return _run(
        ["git", "-C", str(root), *args],
        check=check,
    ).stdout.strip()


def _canonical_github_remote(value: str) -> str | None:
    match = _GITHUB_REMOTE_RE.fullmatch(value.strip())
    if match is None:
        return None
    owner, repository = match.groups()
    if repository.lower().endswith(".git"):
        repository = repository[:-4]
    if not owner or not repository:
        return None
    return (
        f"https://github.com/{owner.casefold()}/"
        f"{repository.casefold()}.git"
    )


def _validated_upstream_url(source_root: Path) -> str:
    configured_url = _git(
        source_root,
        "config",
        "--get",
        "remote.upstream.url",
        check=False,
    )
    normalized_url = _canonical_github_remote(configured_url)
    if normalized_url != EXPECTED_UPSTREAM_URL:
        configured = configured_url or "not configured"
        raise DeployError(
            "remote 'upstream' must resolve to "
            f"{EXPECTED_UPSTREAM_URL}; found {configured}"
        )
    return normalized_url


def source_contract(source_root: Path) -> dict:
    """Return source provenance, refusing a dirty or non-dev checkout."""
    if (
        _git(
            source_root,
            "rev-parse",
            "--is-inside-work-tree",
            check=False,
        )
        != "true"
    ):
        raise DeployError(f"source is not a Git checkout: {source_root}")
    dirty = _git(
        source_root,
        "status",
        "--porcelain",
        "--untracked-files=all",
    )
    if dirty:
        raise DeployError(
            "source checkout is dirty; commit or remove every change before "
            "preparing Diogenes-prod"
        )
    branch = _git(source_root, "branch", "--show-current")
    if branch != "dev":
        raise DeployError(
            f"source branch must be dev, found {branch or 'detached HEAD'}"
        )
    upstream_url = _validated_upstream_url(source_root)
    head = _git(source_root, "rev-parse", "HEAD")
    upstream = _git(
        source_root,
        "rev-parse",
        "--verify",
        "upstream/dev",
        check=False,
    )
    if not upstream:
        raise DeployError(
            "upstream/dev is unavailable; configure the odysseus-dev/odysseus "
            "upstream remote and fetch its dev branch"
        )
    ancestor = (
        _run(
            [
                "git",
                "-C",
                str(source_root),
                "merge-base",
                "--is-ancestor",
                upstream,
                head,
            ],
            check=False,
        ).returncode
        == 0
    )
    if not ancestor:
        raise DeployError("upstream/dev is not an ancestor of source HEAD")
    return {
        "root": str(source_root.resolve()),
        "branch": branch,
        "head": head,
        "upstream_url": upstream_url,
        "upstream_dev": upstream,
        "ahead": int(
            _git(source_root, "rev-list", "--count", f"{upstream}..{head}")
        ),
        "upstream_ancestor_verified": True,
        "clean": True,
    }


def fetch_upstream(source_root: Path) -> None:
    """Refresh only upstream/dev before provenance inspection."""
    _validated_upstream_url(source_root)
    _run(
        [
            "git",
            "-C",
            str(source_root),
            "fetch",
            "--prune",
            "upstream",
            "dev:refs/remotes/upstream/dev",
        ]
    )


def runtime_contract(runtime_root: Path) -> dict:
    present = runtime_root.is_dir()
    git_present = (runtime_root / ".git").is_dir()
    return {
        "root": str(runtime_root),
        "present": present,
        "git_present": git_present,
        "head": (
            _git(runtime_root, "rev-parse", "HEAD", check=False) or None
            if git_present
            else None
        ),
        "env_present": (runtime_root / ".env").is_file(),
        "venv_present": (runtime_root / ".venv" / "pyvenv.cfg").is_file(),
        "data_present": (runtime_root / "data").is_dir(),
        "uvsetup_present": (runtime_root / "uvsetup.sh").is_file(),
        "self_contained": (
            present
            and not (runtime_root / ".env").is_symlink()
            and not (runtime_root / "data").is_symlink()
        ),
    }


def prepare_runtime(source_root: Path, runtime_root: Path) -> dict:
    provenance = source_contract(source_root)
    if runtime_root.exists():
        raise DeployError(
            f"runtime target already exists: {runtime_root}; move or remove "
            "that exact tree deliberately before preparing another copy"
        )
    if runtime_root.resolve() == source_root.resolve():
        raise DeployError("runtime target cannot be the development checkout")
    runtime_root.parent.mkdir(parents=True, exist_ok=True)
    _run(
        [
            "git",
            "clone",
            "--local",
            "--no-hardlinks",
            "--branch",
            "dev",
            str(source_root.resolve()),
            str(runtime_root.resolve()),
        ]
    )
    try:
        _git(runtime_root, "remote", "rename", "origin", "source")
        _git(runtime_root, "remote", "set-url", "--push", "source", "DISABLED")
        _git(
            runtime_root,
            "remote",
            "add",
            "upstream",
            provenance["upstream_url"],
        )
        _git(
            runtime_root,
            "remote",
            "set-url",
            "--push",
            "upstream",
            "DISABLED",
        )
    except Exception:
        # The clone remains inspectable if post-clone metadata fails; never
        # erase an unexpected path as part of recovery.
        raise

    runtime_head = _git(runtime_root, "rev-parse", "HEAD")
    manifest = {
        "schema_version": "diogenes.runtime.v1",
        "self_contained": True,
        "source": provenance,
        "runtime": {
            "root": str(runtime_root.resolve()),
            "branch": _git(runtime_root, "branch", "--show-current"),
            "head": runtime_head,
        },
    }
    if runtime_head != provenance["head"]:
        raise DeployError(
            "prepared runtime HEAD does not match the reviewed source commit"
        )
    (runtime_root / ".diogenes-runtime.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    return {
        "ok": True,
        "runtime": runtime_contract(runtime_root),
        "source": provenance,
        "ports_started": [],
        "next": (
            f"cd {runtime_root.resolve()} && ./uvsetup.sh"
        ),
    }


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="diogenes-deploy")
    parser.add_argument("--pretty", action="store_true")
    parser.add_argument(
        "--fetch-upstream",
        action="store_true",
        help="refresh upstream/dev before inspecting or preparing",
    )
    parser.add_argument("--source-root", type=Path, default=SOURCE_ROOT)
    parser.add_argument(
        "--runtime-root",
        type=Path,
        default=DEFAULT_RUNTIME_ROOT,
    )
    parser.add_argument("command", choices=("inspect", "prepare"))
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    source_root = args.source_root.expanduser().resolve()
    runtime_root = args.runtime_root.expanduser().resolve()
    try:
        if args.fetch_upstream:
            fetch_upstream(source_root)
        payload = (
            {
                "ok": True,
                "source": source_contract(source_root),
                "runtime": runtime_contract(runtime_root),
            }
            if args.command == "inspect"
            else prepare_runtime(source_root, runtime_root)
        )
        print(
            json.dumps(
                payload,
                indent=2 if args.pretty else None,
                sort_keys=True,
            )
        )
        return 0
    except DeployError as exc:
        print(
            json.dumps(
                {"ok": False, "error": str(exc)},
                indent=2 if args.pretty else None,
                sort_keys=True,
            )
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
