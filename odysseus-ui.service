# Ɗiogenēs per-user systemd unit.
# install-service.sh maintains current as a symlink to the invoking checkout.
[Unit]
Description=Ɗiogenēs local AI workstation
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/diogenes/current
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/diogenes/current/startwithuv.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
