# Ɗiogenēs per-user systemd unit.
# install-service.sh maintains current as a symlink to the invoking checkout.
[Unit]
Description=Ɗiogenēs local AI workstation
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/diogenes/current
EnvironmentFile=%h/.local/share/diogenes/current/.env
ExecStart=%h/.local/share/diogenes/current/.venv/bin/python -m uvicorn app:app --port 7000 --host 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
